generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MEMBER
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
}

enum MaritalStatus {
  MENIKAH
  BELUM_MENIKAH
  CERAI_HIDUP
  CERAI_MATI
}

/// Peserta yang melihat sebuah pertanyaan prompt, menurut status pernikahannya.
enum QuestionAudience {
  SEMUA
  MENIKAH
  BELUM_MENIKAH
}

enum PromptStatus {
  DRAF
  TERJADWAL
  TERBIT
}

enum QuestionType {
  TEXT
  SCALE
  CHOICE
  MOOD
}

enum AttachmentKind {
  IMAGE
  AUDIO
  VIDEO
}

enum AssessmentKind {
  PRE
  POST
}

enum AssessmentPart {
  MINDSET
  HABIT
}

model User {
  id                 Int            @id @default(autoincrement())
  name               String
  /// Opsional: akun yang dibuat admin hanya punya nama dan WhatsApp.
  email              String?        @unique
  whatsapp           String
  passwordHash       String
  /// True untuk akun buatan admin yang masih memakai password default; harus diganti sebelum bisa masuk.
  mustChangePassword Boolean        @default(false)
  role               Role           @default(MEMBER)
  status             UserStatus     @default(PENDING)
  avatarUrl          String?
  /// Potensi & keahlian yang diisi peserta di halaman profil.
  skills             String[]
  /// Kegiatan sehari-hari / kesibukan yang diisi peserta di halaman profil.
  activities         String         @default("")
  /// Status pernikahan yang diisi peserta di halaman profil; null = belum diisi.
  maritalStatus      MaritalStatus?
  joinedAt           DateTime       @default(now())
  activatedAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  promptResponses     PromptResponse[]
  assessmentResponses AssessmentResponse[]
  notifications       Notification[]
  courseEnrollments   CourseEnrollment[]
  blogPosts           BlogPost[]
  blogComments        BlogComment[]

  @@index([role, status])
}

model Session {
  /// SHA-256 dari token di cookie; token mentahnya tidak pernah disimpan.
  id        String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 dari token pada tautan reset.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model JournalPrompt {
  id        Int          @id @default(autoincrement())
  title     String
  subtitle  String       @default("")
  /// Tanggal tayang di jurnal peserta. Satu prompt per tanggal.
  date      DateTime     @unique @db.Date
  /// Status tersimpan; status efektif (TERJADWAL yang sudah lewat tanggal = TERBIT) dihitung saat dibaca.
  status    PromptStatus @default(TERJADWAL)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  questions PromptQuestion[]
  responses PromptResponse[]
}

model PromptQuestion {
  id       Int              @id @default(autoincrement())
  promptId Int
  prompt   JournalPrompt    @relation(fields: [promptId], references: [id], onDelete: Cascade)
  position Int
  type     QuestionType
  label    String
  /// Hanya dipakai tipe CHOICE.
  options  String[]
  /// False: peserta boleh mengosongkan jawaban (hanya berlaku untuk tipe TEXT).
  required Boolean          @default(true)
  /// Angka tertinggi skala 1..scaleMax (3-10); hanya dipakai tipe SCALE.
  scaleMax Int              @default(10)
  /// Siapa yang melihat pertanyaan ini; peserta yang belum mengisi status hanya melihat SEMUA.
  audience QuestionAudience @default(SEMUA)

  answers PromptAnswer[]

  @@unique([promptId, position])
}

/// Entri jurnal peserta untuk satu hari. Bila hari itu ada prompt, `promptId` terisi dan
/// jawaban per pertanyaan ada di PromptAnswer; tanpa prompt, hanya `content` (jurnal bebas).
model PromptResponse {
  id         Int            @id @default(autoincrement())
  promptId   Int?
  prompt     JournalPrompt? @relation(fields: [promptId], references: [id], onDelete: Cascade)
  userId     Int
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Tanggal jurnal (WIB). Satu entri per peserta per hari.
  date       DateTime       @db.Date
  /// Catatan Rasa (refleksi bebas).
  content    String         @default("")
  /// Dibagikan ke coach; bila false, teks tidak boleh dibaca admin.
  shared     Boolean        @default(true)
  answeredAt DateTime
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  answers     PromptAnswer[]
  attachments PromptAttachment[]

  @@unique([promptId, userId])
  @@unique([userId, date])
}

model PromptAnswer {
  id         Int            @id @default(autoincrement())
  responseId Int
  response   PromptResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId Int
  question   PromptQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value      String

  @@unique([responseId, questionId])
}

model PromptAttachment {
  id         Int            @id @default(autoincrement())
  responseId Int
  response   PromptResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  kind       AttachmentKind
  title      String
  /// URL statis (data contoh di /public); berkas unggahan peserta memakai `key`.
  src        String?
  poster     String?
  meta       String?
  /// Kunci objek di bucket R2 (privat; dibaca lewat URL bertanda tangan).
  key        String?        @unique
  size       Int?

  @@index([responseId])
}

model AssessmentItem {
  id        Int            @id @default(autoincrement())
  kind      AssessmentKind
  part      AssessmentPart
  dimension String
  text      String
  position  Int

  answers AssessmentAnswer[]

  @@index([kind, part, position])
}

model AssessmentResponse {
  id         Int            @id @default(autoincrement())
  kind       AssessmentKind
  userId     Int
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  answeredAt DateTime

  answers AssessmentAnswer[]

  @@unique([kind, userId])
  @@index([userId])
}

model AssessmentAnswer {
  responseId Int
  response   AssessmentResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  itemId     Int
  item       AssessmentItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// Skala 1-5.
  value      Int

  @@id([responseId, itemId])
}

/// Pengaturan tampil assessment ke peserta. Tanpa baris: Pre tampil, Post tersembunyi (default).
model AssessmentSetting {
  kind    AssessmentKind @id
  visible Boolean        @default(false)
}

enum NotificationKind {
  REFLEKSI
  PESAN
  HADIS
  SISTEM
}

/// Notifikasi untuk satu peserta; `detail` adalah isi lengkap yang dibuka dari daftar notifikasi.
model Notification {
  id          Int              @id @default(autoincrement())
  userId      Int
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        NotificationKind
  title       String
  /// Ringkasan satu-dua kalimat untuk daftar.
  body        String
  /// Isi lengkap (teks, baris baru dipertahankan).
  detail      String
  /// Tautan aksi opsional di halaman detail, mis. "/journal/tulis".
  href        String?
  actionLabel String?
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  @@index([userId, createdAt])
}

/// Kelas buatan admin (mis. Mirrage Life) yang terdiri dari beberapa sesi.
model Course {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @default("")
  /// Kunci objek poster di bucket R2 (boleh lebih dari satu, urut tampil).
  posterKeys  String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions    CourseSession[]
  enrollments CourseEnrollment[]
}

/// Cara sesi kelas diikuti.
enum SessionMode {
  ONLINE
  OFFLINE
  HYBRID
}

model CourseSession {
  id         Int      @id @default(autoincrement())
  courseId   Int
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  position   Int
  title      String
  date       DateTime @db.Date
  /// Jam mulai (WIB) format HH:MM; kosong bila belum ditentukan.
  time       String   @default("")
  /// Jam berakhir (WIB) format HH:MM; opsional, kosong bila tidak ditentukan.
  endTime    String   @default("")
  mode       SessionMode @default(ONLINE)
  /// Tautan Zoom / Google Meet sesi ini (sesi online dan hybrid).
  meetingUrl String   @default("")
  /// Nama lokasi acara (sesi offline dan hybrid).
  locationName String @default("")
  /// Tautan Google Maps lokasi acara.
  mapsUrl      String @default("")

  instructorName     String  @default("")
  instructorBio      String  @default("")
  instructorPhotoKey String?

  recordings CourseRecording[]
  documents  CourseDocument[]

  @@unique([courseId, position])
}

/// Video rekaman sebuah sesi; satu sesi boleh punya banyak rekaman.
model CourseRecording {
  id        Int           @id @default(autoincrement())
  sessionId Int
  session   CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  title     String
  name      String
  key       String        @unique
  /// Byte; BigInt karena rekaman bisa lebih dari 2 GB.
  size      BigInt
}

model CourseDocument {
  id        Int           @id @default(autoincrement())
  sessionId Int
  session   CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name      String
  key       String        @unique
  size      Int
}

/// Peserta yang didaftarkan admin ke sebuah kelas.
model CourseEnrollment {
  id        Int      @id @default(autoincrement())
  courseId  Int
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([courseId, userId])
  @@index([userId])
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

/// Artikel blog yang ditulis admin. Isi disimpan sebagai dokumen Tiptap (JSON); media memakai key R2.
model BlogPost {
  id          Int        @id @default(autoincrement())
  slug        String     @unique
  title       String
  excerpt     String     @default("")
  /// Kunci objek R2 gambar sampul.
  coverKey    String?
  content     Json
  tags        String[]
  status      BlogStatus @default(DRAFT)
  publishedAt DateTime?

  /// Akun penulis bila artikel ditulis atas nama akun yang login; null bila diisi manual.
  authorUserId Int?
  author       User?   @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  authorName   String
  authorBio    String  @default("")
  /// Kunci R2 atau data URL foto penulis.
  authorPhoto  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  likes    BlogLike[]
  comments BlogComment[]

  @@index([status, publishedAt])
}

/// Satu suka per pengunjung; `actor` = "u:<userId>" untuk akun masuk, "v:<token>" untuk pengunjung anonim.
model BlogLike {
  id        Int      @id @default(autoincrement())
  postId    Int
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  actor     String
  createdAt DateTime @default(now())

  @@unique([postId, actor])
}

model BlogComment {
  id         Int      @id @default(autoincrement())
  postId     Int
  post       BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  /// Null untuk komentar anonim (pengunjung belum masuk).
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName String
  body       String
  createdAt  DateTime @default(now())

  @@index([postId, createdAt])
}
